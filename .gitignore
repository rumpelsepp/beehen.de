# Generated files by hugo
.vscode
/public/
/resources/_gen/
/assets/jsconfig.json
hugo_stats.json

# Executable may be added to repository
hugo.exe
hugo.darwin
hugo.linux

# Temporary lock file while building
/.hugo_build.lock
*Zone.Identifier

# Office
~$*
*.~*

# Python
.mypy_cache
.ruff_cache
.venv

/.hugo_build.lock

# Web videos: scripts/vidpre.py builds <name>.mp4 + <name>-poster.jpg from the
# committed <name>.raw.<ext> source (done in CI). Legacy VID_*.mp4 stay tracked.
/content/**/*-poster.jpg
/content/**/*.webm
/content/**/*.mp4
!/content/**/*.raw.*
!/content/**/VID_*.mp4

# esbuild output (bundled from npm deps), fingerprinted + published by Hugo
/assets/gen/
# guard: bundler output must land in assets/gen/, never in static/
/static/*.js
/static/*.css
/static/*.map
/static/*.woff
/static/*.woff2
/node_modules
